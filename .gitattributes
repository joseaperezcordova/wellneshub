# Normaliza los finales de línea: LF en el repositorio siempre.
# El deploy corre en Ubuntu; sin esto, los archivos editados en Windows suben
# con CRLF y cada commit genera un diff completo del archivo.
* text=auto eol=lf

# Binarios: sin conversión ni diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
