# Estado del deploy FTP (lo genera la accion, vive en el servidor)
.ftp-deploy-sync-state.json

# Entorno / credenciales
# config.local.php lleva la contraseña de la base y el secreto de OAuth de
# Google. Nunca entra en el repositorio: se crea a mano en cada sitio donde
# corre la aplicación (local y servidor).
.env
.env.*
config/config.local.php
app/includes/config.local.php

# Dependencias
/node_modules/
/vendor/

# Logs y temporales
*.log
/logs/
/tmp/

# Sistema operativo / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
*~
